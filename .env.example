# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/james_bot

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Anthropic Claude API (required) ───
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ─── OpenAI API (recommended — for embeddings and GPT models) ───
OPENAI_API_KEY=sk-proj-your-key-here

# ─── Voyage AI Embeddings (optional fallback) ───
VOYAGEAI_API_KEY=pa-your-key-here

# ─── Local AI / Ollama (optional — auto-detected) ───
# OLLAMA_BASE_URL=http://localhost:11434

# ─── JWT Auth ───
JWT_SECRET=change-this-to-a-random-64-char-string

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000

# ─── Telegram (optional — can also set via dashboard Settings page) ───
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=your_api_hash_here
# TELEGRAM_PHONE=+1234567890
# TELEGRAM_SESSION_STRING=

# ─── Password Reset / Email (optional — logs link to console if not set) ───
FRONTEND_URL=http://localhost:3000
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=you@gmail.com
# SMTP_FROM_NAME=James Bot

# ─── Frontend (set during build for production) ───
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/ws
